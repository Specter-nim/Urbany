{
  "info": {
    "_postman_id": "c9b7f6c2-urbany-collection-001",
    "name": "CRM URBANY API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-login si no hay token",
          "if (!pm.environment.get('access_token')) {",
          "  pm.sendRequest({",
          "    url: pm.environment.get('base_url') + '/auth/login/',",
          "    method: 'POST',",
          "    header: { 'Content-Type': 'application/json' },",
          "    body: { mode: 'raw', raw: JSON.stringify({",
          "      email: pm.environment.get('admin_email'),",
          "      password: pm.environment.get('admin_password')",
          "    }) }",
          "  }, function (err, res) {",
          "    if (!err && res && res.code === 200) {",
          "      try {",
          "        const data = res.json();",
          "        const tokens = data.tokens || data;",
          "        pm.environment.set('access_token', tokens.access);",
          "        pm.environment.set('refresh_token', tokens.refresh);",
          "      } catch(e) { /* noop */ }",
          "    }",
          "  });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" } ],
            "url": { "raw": "{{base_url}}/auth/login/", "host": ["{{base_url}}"], "path": ["auth", "login", ""] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{admin_email}}\",\n  \"password\": \"{{admin_password}}\"\n}" }
          },
          "event": [
            { "listen": "test", "script": { "exec": [
              "pm.test('Status 200', function(){ pm.response.to.have.status(200); });",
              "const r = pm.response.json(); const t = r.tokens || r; pm.expect(t).to.have.property('access'); pm.expect(t).to.have.property('refresh');",
              "pm.environment.set('access_token', t.access); pm.environment.set('refresh_token', t.refresh);"
            ] } }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
            "url": { "raw": "{{base_url}}/auth/me/", "host": ["{{base_url}}"], "path": ["auth", "me", ""] }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test('Status 200', function(){ pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Health",
          "request": { "method": "GET", "url": { "raw": "{{base_url}}/auth/health/", "host": ["{{base_url}}"], "path": ["auth", "health", ""] } },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test('Status 200', function(){ pm.response.to.have.status(200); });" ] } } ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [ { "key": "Content-Type", "value": "application/json" }, { "key": "Authorization", "value": "Bearer {{access_token}}" } ],
            "url": { "raw": "{{base_url}}/auth/logout/", "host": ["{{base_url}}"], "path": ["auth", "logout", ""] },
            "body": { "mode": "raw", "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}" }
          },
          "event": [ { "listen": "test", "script": { "exec": [ "pm.test('Status 200', function(){ pm.response.to.have.status(200); });" ] } } ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        { "name": "List", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ], "url": { "raw": "{{base_url}}/users/", "host": ["{{base_url}}"], "path": ["users", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] }
      ]
    },
    { "name": "Roles", "item": [ { "name": "List", "request": { "method": "GET", "header": [ { "key": "Authorization", "value": "Bearer {{access_token}}" } ], "url": { "raw": "{{base_url}}/roles/", "host": ["{{base_url}}"], "path": ["roles", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Contacts", "item": [ { "name": "Root", "request": { "method": "GET", "url": { "raw": "{{base_url}}/contacts/", "host": ["{{base_url}}"], "path": ["contacts", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Messages", "item": [ { "name": "Root", "request": { "method": "GET", "url": { "raw": "{{base_url}}/messages/", "host": ["{{base_url}}"], "path": ["messages", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Business", "item": [ { "name": "Root", "request": { "method": "GET", "url": { "raw": "{{base_url}}/business/", "host": ["{{base_url}}"], "path": ["business", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Contracts", "item": [ { "name": "Root", "request": { "method": "GET", "url": { "raw": "{{base_url}}/contracts/", "host": ["{{base_url}}"], "path": ["contracts", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Properties", "item": [ { "name": "Root", "request": { "method": "GET", "url": { "raw": "{{base_url}}/properties/", "host": ["{{base_url}}"], "path": ["properties", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Reports", "item": [ { "name": "Summary", "request": { "method": "GET", "url": { "raw": "{{base_url}}/reports/summary/", "host": ["{{base_url}}"], "path": ["reports", "summary", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Dashboard", "item": [ { "name": "Metrics", "request": { "method": "GET", "url": { "raw": "{{base_url}}/dashboard/metrics/", "host": ["{{base_url}}"], "path": ["dashboard", "metrics", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] } ] },
    { "name": "Documentation", "item": [
      { "name": "API Docs", "request": { "method": "GET", "url": { "raw": "{{base_url}}/docs/", "host": ["{{base_url}}"], "path": ["docs", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] },
      { "name": "ReDoc", "request": { "method": "GET", "url": { "raw": "{{base_url}}/redoc/", "host": ["{{base_url}}"], "path": ["redoc", ""] } }, "event": [ { "listen": "test", "script": { "exec": [ "pm.test('200', function(){ pm.response.to.have.status(200); });" ] } } ] }
    ] }
  ]
}